# 複製成 .env 再填值（.env 不要上傳到 GitHub）

# 儲存方式：file（本機 JSON 檔，預設）或 supabase
STORE=file
DATA_FILE=./data.json

# LINE Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel（LIFF 所在）
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# 改用 Supabase 時才需要
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# 只在本機測試 API 時打開；正式環境務必刪掉
# DEV_FAKE_LOGIN=1
